# Copy to .env and fill in. Never commit the real .env.

# HTTP
PORT=9749
SELF_ORIGIN=https://ask.example.net

# Identity broker (WHO you are) — opaque sessions, no JWT secret held here
AUTH_ORIGIN=https://auth.example.com
AUTH_INTERNAL_URL=http://127.0.0.1:3600
AUTH_INTERNAL_TOKEN=

# Ops/entitlement service (WHAT you're entitled to) over loopback
OPS_INTERNAL_URL=http://127.0.0.1:9724
UPSTREAM_URL=http://127.0.0.1:9724/api/ask-public

# Shared secret for machine callers (Discord bot PNG render, feedback ingest)
ASK_SECRET=

# Read-only game-state MCP servers
MCP_TOKEN=
MCP_GAMESTATE_URL=http://127.0.0.1:9730/mcp

# LLM providers
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Google Gemini (OpenAI-compatible endpoint; key is sent as a bearer token)
GEMINI_API_KEY=
# Command Code provider API (api.commandcode.ai/provider/v1). Carries the free
# MiniMax lane (minimax/minimax-m3-free). A chain that names a Command Code
# model skips it instantly while this is unset.
COMMANDCODE_API_KEY=

# Model routing (comma-separated fallback chains of model ids). Empty = use the
# built-in default from models.js (DeepSeek Flash led). Production leads the
# everyday tier with Gemini 3.6 Flash and falls back to DeepSeek Flash:
#   ASK_CHAIN_FLASH=gemini-3.6-flash,deepseek-v4-flash
# Gemini needs GEMINI_API_KEY set; reasoning cannot be disabled, so it runs at
# low effort (models.js maps it) for ~3s to first token.
MODEL_LABEL=
ASK_CHAIN_FLASH=
ASK_CHAIN_PRO=
ASK_CHAIN_DEEP=
ASK_HELPER_CHAIN=

# Agentic investigation budgets
ASK_INVESTIGATE_ROUNDS=2
ASK_INVESTIGATE_CALLS=6
ASK_INVESTIGATE_DEADLINE_MS=30000
